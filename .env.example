# 复制本文件为 .env 后填入真实值；.env 已被 .gitignore 忽略，不会提交到仓库。
# 启动脚本 start-backend.ps1 会自动读取同目录下的 .env。

# MySQL 连接（DB_NAME / DB_USER / DB_PASSWORD 必填）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chatroom
DB_USER=chat_app
DB_PASSWORD=change_me
DB_CONNECT_TIMEOUT_SECONDS=5

# 前端目录，相对路径以项目根目录为基准
FRONTEND_DIR=frontend

# 页面与接口同源后一般用不到；仅在同源之外另有前端时才需要
FRONTEND_ORIGIN=http://localhost:8080