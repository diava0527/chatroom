# 可选：复制本文件为 .env 后填入真实值，之后启动就不用再输数据库密码。
# 不创建 .env 也能运行，start-backend.ps1 会在启动时提示输入密码（不落盘）。
# .env 已被 .gitignore 忽略，不会提交到仓库。

# MySQL 连接（通过 start-backend.ps1 启动时，DB_NAME/DB_USER 默认 chatroom/chat_app，密码可留空由提示输入）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chatroom
DB_USER=chat_app
DB_PASSWORD=change_me
DB_CONNECT_TIMEOUT_SECONDS=5

# 前端目录，相对路径以项目根目录为基准
FRONTEND_DIR=frontend

# 页面与接口同源后一般用不到；仅在同源之外另有前端时才需要
FRONTEND_ORIGIN=http://localhost:8080